generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ORGANIZER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OrganizerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrganizerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrganizerAccountStatus {
  ACTIVE
  SUSPENDED
}

enum EventStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  CANCELLED
  COMPLETED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum TicketStatus {
  ACTIVE
  CHECKED_IN
  TRANSFERRED
  VOID
}

enum ResaleStatus {
  DRAFT
  ACTIVE
  SOLD
  CANCELLED
  EXPIRED
}

enum AuditActorType {
  USER
  SYSTEM
}

enum SeatStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum NotificationType {
  ORDER_CREATED
  QR_CHECKED_IN
  EVENT_REMINDER_24H
  EVENT_ENDING_30M
  EVENT_SUBMITTED
  EVENT_PUBLISHED
  EVENT_REJECTED
  NEW_EVENT
  TICKET_SOLD
}

enum NotificationChannel {
  APP
  EMAIL
}

model User {
  id                        Int                      @id @default(autoincrement())
  email                     String                   @unique
  passwordHash              String?
  fullName                  String
  phone                     String?
  avatarUrl                 String?
  role                      Role                     @default(USER)
  status                    UserStatus               @default(ACTIVE)
  organizerId               Int?
  organizer                 Organizer?               @relation(fields: [organizerId], references: [id])
  emailVerifiedAt           DateTime?
  organizerProfile          OrganizerProfile?
  approvedOrganizerProfiles OrganizerProfile[]       @relation("OrganizerApprovedBy")
  reviewedOrganizerApplications OrganizerApplication[] @relation("OrganizerApplicationReviewedBy")
  passwordSetupTokens       PasswordSetupToken[]
  createdEvents             Event[]                  @relation("EventCreator")
  reviewedEvents            Event[]                  @relation("EventReviewer")
  orders                    Order[]
  payments                  Payment[]
  ownedTickets              Ticket[]                 @relation("TicketCurrentOwner")
  initiatedCheckIns         CheckIn[]                @relation("CheckInActor")
  resaleListingsForSale     ResaleListing[]          @relation("ResaleSeller")
  purchasedResales          ResaleListing[]          @relation("ResaleBuyer")
  ownershipTransfersFrom    TicketOwnershipHistory[] @relation("OwnershipFromUser")
  ownershipTransfersTo      TicketOwnershipHistory[] @relation("OwnershipToUser")
  auditLogs                 AuditLog[]               @relation("AuditActor")
  notifications             Notification[]
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  @@index([role, status])
  @@index([organizerId])
}

model OrganizerApplication {
  id                Int                         @id @default(autoincrement())
  companyName       String
  contactName       String
  email             String
  phone             String
  description       String
  websiteUrl        String?
  socialUrl         String?
  status            OrganizerApplicationStatus  @default(PENDING)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  reviewedAt        DateTime?
  reviewedByAdminId Int?
  reviewedByAdmin   User?                       @relation("OrganizerApplicationReviewedBy", fields: [reviewedByAdminId], references: [id])

  @@index([status, createdAt])
  @@index([email])
}

model Organizer {
  id           Int                    @id @default(autoincrement())
  companyName  String
  contactEmail String
  phone        String
  status       OrganizerAccountStatus @default(ACTIVE)
  users        User[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([status])
  @@index([contactEmail])
}

model PasswordSetupToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, usedAt, expiresAt])
}

model OrganizerProfile {
  id           Int             @id @default(autoincrement())
  userId       Int             @unique
  companyName  String
  slug         String          @unique
  description  String?
  websiteUrl   String?
  registrationCode String?
  status       OrganizerStatus @default(PENDING)
  approvedAt   DateTime?
  approvedById Int?
  user         User            @relation(fields: [userId], references: [id])
  approvedBy   User?           @relation("OrganizerApprovedBy", fields: [approvedById], references: [id])
  events       Event[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([status])
}

model Category {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  slug          String        @unique
  description   String?
  displayOrder  Int           @default(0)
  isActive      Boolean       @default(true)
  subcategories Subcategory[]
  events        Event[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Subcategory {
  id          Int       @id @default(autoincrement())
  categoryId  Int
  name        String
  slug        String
  description String?
  isActive    Boolean   @default(true)
  category    Category  @relation(fields: [categoryId], references: [id])
  events      Event[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([categoryId, slug])
  @@index([categoryId, isActive])
}

model Venue {
  id         Int      @id @default(autoincrement())
  name       String
  city       String
  country    String
  address    String
  timezone   String
  capacity   Int
  latitude   Float?
  longitude  Float?
  events     Event[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([city, country])
}

model Event {
  id             Int             @id @default(autoincrement())
  organizerId    Int
  createdById    Int
  reviewedById   Int?
  categoryId     Int
  subcategoryId  Int?
  venueId        Int
  title          String
  slug           String          @unique
  imageUrl       String?
  cardImageUrl   String?
  relatedImages  Json?
  summary        String
  description    String
  startsAt       DateTime
  endsAt         DateTime
  saleStartsAt   DateTime
  saleEndsAt     DateTime
  status         EventStatus     @default(DRAFT)
  reviewNotes    String?
  publishedAt    DateTime?
  isTrending     Boolean          @default(false)
  trendingOrder  Int?
  currency       String          @default("USD")
  platformFeeBps Int             @default(900)
  serviceFeeBps  Int             @default(350)
  transparentFee Boolean         @default(true)
  organizer      OrganizerProfile @relation(fields: [organizerId], references: [id])
  createdBy      User             @relation("EventCreator", fields: [createdById], references: [id])
  reviewedBy     User?            @relation("EventReviewer", fields: [reviewedById], references: [id])
  category       Category         @relation(fields: [categoryId], references: [id])
  subcategory    Subcategory?     @relation(fields: [subcategoryId], references: [id])
  venue          Venue            @relation(fields: [venueId], references: [id])
  ticketTypes    TicketType[]
  orders         Order[]
  tickets        Ticket[]
  checkIns       CheckIn[]
  resaleListings ResaleListing[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, startsAt])
  @@index([isTrending, trendingOrder])
  @@index([organizerId, status])
  @@index([categoryId, startsAt])
}

model TicketType {
  id             Int             @id @default(autoincrement())
  eventId        Int
  name           String
  description    String?
  price          Decimal         @db.Decimal(10, 2)
  quantityTotal  Int
  quantitySold   Int             @default(0)
  maxPerOrder    Int             @default(8)
  resaleAllowed  Boolean         @default(true)
  resalePriceCap Decimal?        @db.Decimal(10, 2)
  hasSeatMap     Boolean         @default(false)
  startsAt       DateTime?
  endsAt         DateTime?
  event          Event           @relation(fields: [eventId], references: [id])
  orderItems     OrderItem[]
  tickets        Ticket[]
  seats          Seat[]
  resaleListings ResaleListing[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([eventId])
}

model Order {
  id         Int             @id @default(autoincrement())
  userId     Int
  eventId    Int
  status     OrderStatus     @default(PENDING_PAYMENT)
  subtotal   Decimal         @db.Decimal(10, 2)
  buyerFee   Decimal         @db.Decimal(10, 2)
  sellerFee  Decimal         @default(0) @db.Decimal(10, 2)
  total      Decimal         @db.Decimal(10, 2)
  currency   String          @default("USD")
  user       User            @relation(fields: [userId], references: [id])
  event      Event           @relation(fields: [eventId], references: [id])
  items      OrderItem[]
  payment    Payment?
  tickets    Ticket[]
  resaleSale ResaleListing[] @relation("ResaleSaleOrder")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([userId, status])
  @@index([eventId, status])
}

model OrderItem {
  id            Int        @id @default(autoincrement())
  orderId       Int
  ticketTypeId  Int
  quantity      Int
  unitPrice     Decimal    @db.Decimal(10, 2)
  lineSubtotal  Decimal    @db.Decimal(10, 2)
  lineBuyerFee  Decimal    @db.Decimal(10, 2)
  lineSellerFee Decimal    @default(0) @db.Decimal(10, 2)
  lineTotal     Decimal    @db.Decimal(10, 2)
  order         Order      @relation(fields: [orderId], references: [id])
  ticketType    TicketType @relation(fields: [ticketTypeId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Payment {
  id                Int           @id @default(autoincrement())
  orderId           Int           @unique
  userId            Int
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("USD")
  provider          String
  providerReference String?
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?
  metadata          Json?
  order             Order         @relation(fields: [orderId], references: [id])
  user              User          @relation(fields: [userId], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId, status])
}

model Ticket {
  id                 Int                      @id @default(autoincrement())
  code               String                   @unique
  qrToken            String                   @unique
  eventId            Int
  ticketTypeId       Int
  orderId            Int?
  currentOwnerId     Int
  status             TicketStatus             @default(ACTIVE)
  resaleAllowed      Boolean                  @default(true)
  originalPrice      Decimal                  @db.Decimal(10, 2)
  currentListedPrice Decimal?                 @db.Decimal(10, 2)
  seatId             Int?                     @unique
  checkedInAt        DateTime?
  event              Event                    @relation(fields: [eventId], references: [id])
  ticketType         TicketType               @relation(fields: [ticketTypeId], references: [id])
  order              Order?                   @relation(fields: [orderId], references: [id])
  currentOwner       User                     @relation("TicketCurrentOwner", fields: [currentOwnerId], references: [id])
  seat               Seat?                    @relation(fields: [seatId], references: [id])
  checkIn            CheckIn?
  resaleListings     ResaleListing[]
  ownershipHistory   TicketOwnershipHistory[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([currentOwnerId, status])
  @@index([eventId, status])
}

model CheckIn {
  id            Int      @id @default(autoincrement())
  ticketId      Int      @unique
  eventId       Int
  checkedInById Int
  scannedAt     DateTime @default(now())
  ticket        Ticket   @relation(fields: [ticketId], references: [id])
  event         Event    @relation(fields: [eventId], references: [id])
  checkedInBy   User     @relation("CheckInActor", fields: [checkedInById], references: [id])

  @@index([eventId, scannedAt])
}

model ResaleListing {
  id           Int          @id @default(autoincrement())
  ticketId     Int
  sellerId     Int
  buyerId      Int?
  saleOrderId  Int?
  eventId      Int
  ticketTypeId Int
  status       ResaleStatus @default(DRAFT)
  askPrice     Decimal      @db.Decimal(10, 2)
  buyerFee     Decimal      @default(0) @db.Decimal(10, 2)
  sellerFee    Decimal      @default(0) @db.Decimal(10, 2)
  listedAt     DateTime     @default(now())
  expiresAt    DateTime?
  soldAt       DateTime?
  ticket       Ticket       @relation(fields: [ticketId], references: [id])
  seller       User         @relation("ResaleSeller", fields: [sellerId], references: [id])
  buyer        User?        @relation("ResaleBuyer", fields: [buyerId], references: [id])
  saleOrder    Order?       @relation("ResaleSaleOrder", fields: [saleOrderId], references: [id])
  event        Event        @relation(fields: [eventId], references: [id])
  ticketType   TicketType   @relation(fields: [ticketTypeId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([ticketId, status])
  @@index([eventId, status])
  @@index([sellerId, status])
}

model TicketOwnershipHistory {
  id          Int      @id @default(autoincrement())
  ticketId    Int
  fromUserId  Int?
  toUserId    Int
  acquiredVia String
  notes       String?
  createdAt   DateTime @default(now())
  ticket      Ticket   @relation(fields: [ticketId], references: [id])
  fromUser    User?    @relation("OwnershipFromUser", fields: [fromUserId], references: [id])
  toUser      User     @relation("OwnershipToUser", fields: [toUserId], references: [id])

  @@index([ticketId, createdAt])
  @@index([toUserId, createdAt])
}

model Seat {
  id           Int        @id @default(autoincrement())
  ticketTypeId Int
  row          String
  number       Int
  label        String
  status       SeatStatus @default(AVAILABLE)
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])
  ticket       Ticket?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([ticketTypeId, row, number])
  @@index([ticketTypeId, status])
}

model AuditLog {
  id          Int            @id @default(autoincrement())
  actorType   AuditActorType @default(USER)
  actorUserId Int?
  action      String
  entityType  String
  entityId    Int
  description String?
  metadata    Json?
  createdAt   DateTime       @default(now())
  actorUser   User?          @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
}

model Notification {
  id          Int                 @id @default(autoincrement())
  userId      Int
  type        NotificationType
  channel     NotificationChannel @default(APP)
  title       String
  message     String
  actionUrl   String?
  eventId     Int?
  ticketId    Int?
  orderId     Int?
  dedupeKey   String?             @unique
  isRead      Boolean             @default(false)
  readAt      DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  user        User                @relation(fields: [userId], references: [id])

  @@index([userId, isRead, createdAt])
  @@index([userId, type, createdAt])
}

model ContactInquiry {
  id         Int      @id @default(autoincrement())
  phone      String
  email      String
  ticketType String
  message    String
  createdAt  DateTime @default(now())
}
