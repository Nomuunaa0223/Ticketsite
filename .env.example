
JWT_SECRET="replace-with-a-long-random-secret"
NEXT_PUBLIC_APP_URL="https://localhost:3000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3000"

# Realtime + temporary memory
# Required for split Vercel + Render/Railway realtime because it carries Socket.IO events across processes.
REDIS_URL="redis://localhost:6379"
SEAT_LOCK_TTL_SECONDS="300"
SOCKET_ORIGIN="https://localhost:3000"

# AI providers are optional. Leave these blank for free PostgreSQL fallback mode.
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
PINECONE_API_KEY=""
PINECONE_INDEX=""
PINECONE_NAMESPACE="events"

GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="your-gmail-app-password"
